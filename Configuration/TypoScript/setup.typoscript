pdflip = PAGE
pdflip {
  typeNum = 68724
  config {
    additionalHeaders = Content-Type: text/html
    no_cache = 1
    xhtml_cleaning = 0
    admPanel = 0
    debug = 0
  }

  includeCSS {
    pdflip = EXT:pdflip/Resources/Public/CSS/dflip.css
    themify-icons = EXT:pdflip/Resources/Public/CSS/themify-icons.min.css
  }

  includeJSFooterlibs {
    jquery = EXT:pdflip/Resources/Public/JavaScript/Frontend/libs/jquery.min.js
    three = EXT:pdflip/Resources/Public/JavaScript/Frontend/libs/three.min.js
    pdfjs = EXT:pdflip/Resources/Public/JavaScript/Frontend/libs/pdf.min.js
    pdfjsworker = EXT:pdflip/Resources/Public/JavaScript/Frontend/libs/pdf.worker.min.js
  }

  includeJSFooter {
    pdflip = EXT:pdflip/Resources/Public/JavaScript/Frontend/dflip.js
  }

  10 = FLUIDTEMPLATE
  10 {

    dataProcessing {
      10 = pdflip-file-public-url
    }

    file = EXT:pdflip/Resources/Private/Frontend/Templates/PDFlip.html
    variables {

    }

    settings {
      assets {
        importJQuery = {$plugin.tx_pdflip.settings.importJQuery}
        useNonce = {$plugin.tx_pdflip.settings.useNonce}
      }
    }

  }
}


tt_content.pdflip-gallery < lib.contentElement
tt_content.pdflip-gallery {

  templateName = PdflipGallery

  templateRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Templates/
    10 = EXT:pdflip/Resources/Private/Frontend/Templates/
    20 = {$plugin.tx_pdflip.view.templateRootPath}
  }

  partialRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Partials/
    10 = EXT:pdflip/Resources/Private/Frontend/Partials/
    20 = {$plugin.tx_pdflip.view.partialRootPath}
  }

  layoutRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Layouts/
    10 = EXT:pdflip/Resources/Private/Frontend/Layouts/
    20 = {$plugin.tx_pdflip.view.layoutRootPath}
  }

  settings {

    assets {

      importJQuery = {$plugin.tx_pdflip.settings.importJQuery}
      useNonce = {$plugin.tx_pdflip.settings.useNonce}
    }

  }

  dataProcessing {
    10 = files
    10 {
      references.fieldName = assets
    }
  }

}


tt_content.pdflip-embedded < lib.contentElement
tt_content.pdflip-embedded {

  templateName = PdflipEmbedded


  templateRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Templates/
    10 = EXT:pdflip/Resources/Private/Frontend/Templates/
    20 = {$plugin.tx_pdflip.view.templateRootPath}
  }

  partialRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Partials/
    10 = EXT:pdflip/Resources/Private/Frontend/Partials/
    20 = {$plugin.tx_pdflip.view.partialRootPath}
  }

  layoutRootPaths {
    0 = EXT:fluid_styled_content/Resources/Private/Layouts/
    10 = EXT:pdflip/Resources/Private/Frontend/Layouts/
    20 = {$plugin.tx_pdflip.view.layoutRootPath}
  }

  settings {

    assets {

      importJQuery = {$plugin.tx_pdflip.settings.importJQuery}
      useNonce = {$plugin.tx_pdflip.settings.useNonce}
    }

  }

  dataProcessing {
    10 = files
    10 {
      references.fieldName = assets
    }
    50 = TYPO3\CMS\Frontend\DataProcessing\FlexFormProcessor
  }

}
