{
    "name": "wapplersystems/pdflip",
    "description": "PDF flipbook viewer extension for TYPO3",
    "type": "typo3-cms-extension",
    "homepage": "https://github.com/WapplerSystems/t3-flipbook",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "pdf",
        "flipbook"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-flipbook/issues",
        "source": "https://github.com/WapplerSystems/t3-flipbook"
    },
    "require": {
        "typo3/cms-core": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Pdflip\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "pdflip"
        }
    }
}