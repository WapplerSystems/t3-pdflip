{
    "name": "wapplersystems/pdflip",
    "type": "typo3-cms-extension",
    "description": "PDF flip books for TYPO3: page-turning PDF viewer based on the open-source pdflip library",
    "keywords": ["TYPO3", "extension", "pdf", "flipbook", "flip book", "pdf viewer"],
    "homepage": "https://github.com/WapplerSystems/t3-pdflip",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "source": "https://github.com/WapplerSystems/t3-pdflip",
        "issues": "https://github.com/WapplerSystems/t3-pdflip/issues"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-filelist": "^13.4 || ^14.0",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.0",
        "typo3/cms-frontend": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\Pdflip\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "pdflip"
        }
    }
}
